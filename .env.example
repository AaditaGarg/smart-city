# Database configuration (Defaults to local smartcity.db SQLite)
DATABASE_URL=sqlite:///./smartcity.db

# Optional PostgreSQL configuration
# POSTGRES_USER=smartcity
# POSTGRES_PASSWORD=smartcity_pw
# POSTGRES_DB=smartcity
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql+psycopg2://smartcity:smartcity_pw@localhost:5432/smartcity

MODEL_DIR=models
CORS_ORIGINS=http://localhost:5173

# --- Security ---
# Set REQUIRE_API_KEY=true and choose a long random API_KEY (e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`)
# to protect every POST/PATCH endpoint with the X-API-Key header. No default key is shipped.
REQUIRE_API_KEY=false
API_KEY=

# --- Models ---
# When trained weights are missing the API answers 503. Set to true ONLY for demos: it enables a classical
# computer-vision heuristic (NOT a trained model) and labels results "<task>_heuristic_DEMO".
ALLOW_HEURISTIC_FALLBACK=false
